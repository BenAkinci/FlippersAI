{
  "manifest_version": 3,
  "name": "FlippersAI — Reseller Workspace",
  "version": "0.81.1",
  "description": "AI-powered reselling workspace with self-healing five-at-a-time Scout startup, one-by-one ratings and guided Verify-first decision checks.",
  "minimum_chrome_version": "114",
  "permissions": ["activeTab","sidePanel","scripting","storage","tabs","clipboardWrite"],
  "host_permissions": [
    "https://msmpigerejpxepkylkxz.supabase.co/*",
    "https://*.facebook.com/*",
    "https://*.fbcdn.net/*",
    "https://*.ebay.com.au/*",
    "https://*.gumtree.com.au/*",
    "https://*.depop.com/*",
    "https://whattheflip-adz.pages.dev/*",
    "https://*.whattheflip-adz.pages.dev/*"
  ],
  "icons": {"16":"icons/icon16.png","32":"icons/icon32.png","48":"icons/icon48.png","128":"icons/icon128.png"},
  "background": {"service_worker":"service-worker.js","type":"module"},
  "action": {"default_title":"Open FlippersAI","default_icon":{"16":"icons/icon16.png","32":"icons/icon32.png"}},
  "side_panel": {"default_path":"sidepanel.html"},
  "content_scripts": [{
    "matches": ["https://*.facebook.com/*","https://*.ebay.com.au/*","https://*.gumtree.com.au/*","https://*.depop.com/*"],
    "js": ["content-v070.js","scout-collection-content.js","scout-rating-overlay.js","marketplace-trust-overlay-v079.js"],
    "run_at": "document_idle"
  }]
}

# Copy this file to .env for local development.
# Never commit real secrets. .env is ignored by git.

# AI coding / local tooling only. Do not expose this key to browser code.
OPENAI_API_KEY=

# Supabase local/tooling values. The browser app currently uses the existing
# publishable project key in app.js; do not put a service-role key here unless
# a local server-side tool explicitly needs it.
SUPABASE_PROJECT_REF=msmpigerejpxepkylkxz
SUPABASE_URL=https://msmpigerejpxepkylkxz.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare local tooling. OAuth via Wrangler/MCP is preferred; these are
# optional when a command explicitly requires them.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_PAGES_PROJECT=whattheflip-adz
